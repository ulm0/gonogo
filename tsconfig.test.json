{
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": { "@/*": ["./src/client/*"] },
    "types": [
      "node"
    ]
  },
  "include": [
    "test",
    "browser",
    "playwright.config.ts",
    "src/server",
    "src/shared"
  ]
}
